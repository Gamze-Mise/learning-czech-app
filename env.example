# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/learning_czech?schema=public"

# App URL (email links; optional on Vercel — server falls back to Host / VERCEL_URL)
# Production: https://your-domain.com or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing — min 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace_with_a_long_random_string_at_least_32_chars"

# Brand name in transactional emails (English; subject + HTML body)
EMAIL_BRAND="Learning Czech"

# Resend — free tier for transactional email (https://resend.com)
# After signup, create an API key and paste it here.
RESEND_API_KEY="re_xxxxxxxx"
# Sender: onboarding@resend.dev only delivers to your Resend-account email in production.
# Verify your domain at resend.com and use e.g. "Learning Czech <noreply@yourdomain.com>"
# EMAIL_FROM="Learning Czech <onboarding@resend.dev>"
EMAIL_FROM="Learning Czech <onboarding@resend.dev>"
